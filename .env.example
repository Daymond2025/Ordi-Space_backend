APP_NAME="OrdiSpace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ordispace
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DRIVER=database

# Liste blanche CORS — une origine par app Next.js, jamais de wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3010
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Administrateur racine, provisionné une seule fois par le seeder DatabaseSeeder.
# Ne jamais committer de vraies valeurs ici : ce fichier sert de modèle public.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ordispace.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Agent IA "Ellah" (page Aide rapide).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Connexion Client par téléphone (WhatsApp + OTP). Si absent/vide, l'envoi
# retombe automatiquement sur un mode de secours (code loggé, jamais exposé
# en production) — voir App\Services\Whatsapp\WhatsappOtpSender.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Encaissement Mobile Money à la livraison — API Wave (compte marchand
# OrdiSpace, jamais celui du livreur). WAVE_WEBHOOK_SECRET est donné par le
# portail Wave au moment de l'enregistrement de l'URL de webhook (distinct de
# la clé API), disponible seulement une fois l'URL /webhooks/wave déployée —
# voir App\Services\Wave\WaveCheckoutService.
WAVE_API_BASE_URL=https://api.wave.com/v1
WAVE_API_KEY=
WAVE_API_MIN_AMOUNT=100
WAVE_API_MAX_AMOUNT=500000
WAVE_WEBHOOK_SECRET=
WAVE_CHECKOUT_SUCCESS_URL=
WAVE_CHECKOUT_ERROR_URL=

# Base de l'app Livreur (Next.js) — sert à construire les liens affiliés
# "Boutique" partagés au public (voir BoutiqueController::genererLien()).
LIVREUR_APP_URL=http://localhost:3000

# Page d'arrivée de l'acheteur (Next.js, dossier page_commande) — cible des liens de vente et du QR.
PAGE_COMMANDE_URL=http://localhost:3010

VITE_APP_NAME="${APP_NAME}"
