# Gabarit de référence pour le .env du SERVEUR de production.
# Ce fichier n'est jamais utilisé automatiquement : il documente ce qui doit
# exister dans /sites/ordisapce.daymondboutique.com/.env, créé et maintenu à
# la main sur le serveur (le pipeline CI/CD ne le touche jamais — décision
# d'architecture). Copiez-le une fois, remplissez les valeurs réelles, et
# gardez-le hors de git.

APP_NAME="OrdiSpace"
APP_ENV=production
APP_KEY=                        # généré une fois sur le serveur : php artisan key:generate
APP_DEBUG=false
APP_URL=https://ordisapce.daymondboutique.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Base de données de production (remplie par vos soins) -----------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true      # HTTPS uniquement en production

SANCTUM_STATEFUL_DOMAINS=       # domaines réels des 3 apps Next.js, séparés par des virgules
SANCTUM_TOKEN_EXPIRATION=43200  # 30 jours en minutes

# Liste blanche CORS — remplacer par les domaines réels des apps Next.js
# (coordinateur, commercial, admin) dès qu'ils sont connus. Jamais de wildcard.
CORS_ALLOWED_ORIGINS=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@daymondboutique.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Administrateur racine (cf. DatabaseSeeder::seedAdministrateurRacine) --
# Uniquement nécessaires le jour du tout premier déploiement / seed.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Déploiement -------------------------------------------------------
# Jeton long et aléatoire (ex. `php artisan tinker --execute="echo Str::random(48);"`)
# à reporter aussi dans le secret GitHub DEPLOY_TOKEN. Change-le et les deux
# doivent être resynchronisés.
DEPLOY_TOKEN=
